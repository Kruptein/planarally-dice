{
    "name": "@planarally/dice",
    "version": "0.9.0",
    "description": "3D dice rolling functionality for babylon.js.",
    "keywords": [
        "3D",
        "DnD",
        "PlanarAlly",
        "babylonjs",
        "dice"
    ],
    "homepage": "https://github.com/Kruptein/planarally-dice#readme",
    "bugs": {
        "url": "https://github.com/Kruptein/planarally-dice/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Kruptein/planarally-dice.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        "./core": {
            "types": "./dist/core/index.d.ts",
            "default": "./dist/core/index.js"
        },
        "./3d": {
            "types": "./dist/3d/index.d.ts",
            "default": "./dist/3d/index.js"
        },
        "./systems/dx": {
            "types": "./dist/systems/dx/index.d.ts",
            "default": "./dist/systems/dx/index.js"
        }
    },
    "scripts": {
        "build": "rimraf dist/ && tsc",
        "format": "oxfmt src",
        "lint": "oxlint src"
    },
    "dependencies": {
        "tslib": "^2.9.1"
    },
    "devDependencies": {
        "@babylonjs/core": "^9.37.0",
        "@babylonjs/havok": "^1.3.14",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "rimraf": "^6.1.4",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "@babylonjs/core": "^9.37.0",
        "@babylonjs/havok": "^1.3.14"
    }
}
