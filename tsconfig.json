{
  "compilerOptions": {
    "declaration": true,
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["DOM", "ES2023", "DOM.Iterable", "ScriptHost"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
